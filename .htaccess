# =========================================
# Colorado Pro Masonry - .htaccess
# Colocar en /public_html/.htaccess
# =========================================

# --- Seguridad básica ---
Options -Indexes

<FilesMatch "(^\.|\.env|package\.json|package-lock\.json|gulpfile\.js|README\.md)">
  Require all denied
</FilesMatch>

# --- Forzar HTTPS + WWW ---
RewriteEngine On

# Si NO es https OR si NO es www => redirige a https://www.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.coloradopromasonryllc\.com$ [NC]
RewriteRule ^ https://www.coloradopromasonryllc.com%{REQUEST_URI} [R=301,L]

# --- Evitar contenido duplicado por /index.html ---
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://www.coloradopromasonryllc.com/ [R=301,L]

# --- Cache estático (mejora PageSpeed) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"

  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"

  ExpiresByType image/jpeg "access plus 180 days"
  ExpiresByType image/jpg "access plus 180 days"
  ExpiresByType image/png "access plus 180 days"
  ExpiresByType image/webp "access plus 180 days"
  ExpiresByType image/avif "access plus 180 days"
  ExpiresByType image/svg+xml "access plus 180 days"
  ExpiresByType image/x-icon "access plus 365 days"

  ExpiresByType font/woff2 "access plus 365 days"
  ExpiresByType font/woff "access plus 365 days"
</IfModule>

<IfModule mod_headers.c>
  # Cache-Control para estáticos
  <FilesMatch "\.(css|js|mjs)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=15552000, immutable"
  </FilesMatch>

  <FilesMatch "\.(woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Seguridad (no rompe el sitio)
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Compresión (Brotli si está disponible, sino Gzip) ---
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# --- MIME para AVIF/WEBP (por si el server no los reconoce) ---
AddType image/avif .avif
AddType image/webp .webp
